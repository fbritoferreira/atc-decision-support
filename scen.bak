import { seedState } from "./data";
import type { Flight, Gate, SimState, Weather } from "./types";

export type ScenarioId =
  | "nominal"
  | "wake-violation"
  | "runway-conflict"
  | "gate-gridlock"
  | "crosswind-storm"
  | "cascading-rush"
  | "crisis"
  | "incident-tenerife-1977"
  | "incident-avianca052-1990"
  | "incident-lax-1991"
  | "incident-linate-2001"
  | "incident-dca-2025"
  | "incident-lga-2025"
  | "incident-jfk-2026"
  | "incident-comair5191-2006"
  | "incident-aa11-2001"
  | "drill-squawk-7500"
  | "negative-control-asrs"
  | "negative-control-goaround"
  | "negative-control-converging-deps"
  | "negative-control-staggered"
  | "negative-control-vfr-corridor"
  | "negative-control-crosswind-ops"
  | "negative-control-wake-at-minimum"
  | "negative-control-parallel-approach"
  | "negative-control-asrs-ewr"
  | "negative-control-asrs-iah"
  | "negative-control-asrs-zma";

export type IncidentInfo = {
  year: number;
  location: string;
  report: string;
  summary: string;
  aiWouldFlag: string;
};

export type Scenario = {
  id: ScenarioId;
  name: string;
  brief: string;
  build: () => SimState;
  incident?: IncidentInfo;
};

const baseFlight = (id: string, callsign: string, overrides: Partial<Flight>): Flight => ({
  id,
  callsign,
  type: "arrival",
  aircraft: "B738",
  wake: "medium",
  origin: "KLAX",
  destination: "KSFO",
  phase: "approach",
  altitudeFt: 4000,
  speedKts: 220,
  headingDeg: 281,
  positionNm: { x: -20, y: 0 },
  fuelMin: 90,
  etaMin: 10,
  squawk: "2400",
  ...overrides,
});

const buildNominal = (): SimState => seedState();

// Positions sit on one lateral stream to 28L (cross-track ~0 for heading
// 281): the wake doctrine pairs same-path followers only, and the original
// scattered positions put these arrivals 2.7 NM apart laterally — three
// different streams, which is not what this scenario means.
const buildWakeViolation = (): SimState => {
  const base = seedState();
  return {
    ...base,
    flights: [
      baseFlight("w1", "UAL901", {
        aircraft: "B789",
        wake: "heavy",
        phase: "final",
        altitudeFt: 1500,
        speedKts: 160,
        positionNm: { x: -3, y: -0.58 },
        assignedRunway: "28L",
        etaMin: 3,
        fuelMin: 60,
      }),
      baseFlight("w2", "SKW42", {
        aircraft: "CRJ7",
        // A CRJ-700 is ICAO Medium at about 34 tonnes, an order of
        // magnitude above the 7-tonne light threshold. Read "light" here and
        // "medium" on the same type in incident-dca-2025 until 2026-08-29.
        wake: "medium",
        phase: "approach",
        altitudeFt: 2400,
        speedKts: 180,
        positionNm: { x: -4, y: -0.78 },
        assignedRunway: "28L",
        etaMin: 4,
        fuelMin: 80,
      }),
      baseFlight("w3", "AAL77", {
        aircraft: "B77W",
        wake: "heavy",
        phase: "approach",
        altitudeFt: 4800,
        speedKts: 230,
        positionNm: { x: -12, y: -2.33 },
        assignedRunway: "28L",
        etaMin: 12,
        fuelMin: 50,
      }),
    ],
  };
};

