};

// Three negative controls encoding specific NASA ASRS reports rather than
// synthetic narrative shapes. Every geometry figure below is stated in the
// cited record; where the record does not state a value, the encoding says so
// in place rather than inventing one. Sources: ASRS Database Report Sets
// (Wake Turbulence Encounters, Update 24, 2024-07-09; Air Traffic Controller
// Reports) and ASRS CALLBACK Issue 461, June 2018.

// NASA ASRS ACN 2071367, January 2024. An A319 on base to ILS 22L at EWR,
// IMC, 3,000 ft MSL, put "within 5 nm of a heavy 787 in moderate turbulence";
// the controller waited for the turn to final to build separation, and the
// crew discontinued and diverted without loss of separation. Under CWT a B
// or D category 787 leading an A319 (category F) carries exactly a 5 NM
// minimum, and "within 5 nm" is inside it, so the correct output is a wake
// WARNING and never a critical: the deficit is a fraction of a mile against a
// critical line a full mile inside the requirement. Encoded at 4.8 NM so the
// verdict does not hang on float rounding at the exact boundary. The 787
// variant is not stated in the record; every passenger variant is CWT B
// except the -10 (D), and both impose the same 5 NM on an F follower, so the
// choice cannot change the requirement.
const buildNegativeAsrsEwr = (): SimState => {
  const base = seedState();
  // Approach course 224: both established inbound, level at intercept
  // altitude, in trail on one localiser.
  const course = { x: Math.sin((224 * Math.PI) / 180), y: -Math.cos((224 * Math.PI) / 180) };
  const at = (dNm: number) => ({ x: -dNm * course.x, y: -dNm * course.y });
  return {
    ...base,
    speed: 0,
    sectorId: "KEWR APP (ASRS ACN 2071367 reconstruction)",
    runways: [
      // headingDeg carries the first-named end's course by convention;
      // resolveRunway adds 180 for the 22L side this scenario flies.
      { id: "04R/22L", headingDeg: 44, lengthFt: 10000, mode: "mixed", surfaceFriction: "wet" },
    ],
    weather: {
      windDirDeg: 260,
      windKts: 18,
      gustsKts: 28,
      visibilityNm: 3,
      ceilingFt: 900,
      condition: "IFR",
      precipitation: "rain",
    },
    flights: [
      baseFlight("asrs-ewr-lead", "HVY787", {
        aircraft: "B788",
        wake: "heavy",
        type: "arrival",
        phase: "approach",
        altitudeFt: 3000,
        speedKts: 190,
        headingDeg: 224,
        positionNm: at(6),
        assignedRunway: "22L",
        etaMin: 4,
        squawk: "2761",
      }),
      baseFlight("asrs-ewr-trail", "AWE319", {
        aircraft: "A319",
        wake: "medium",
        type: "arrival",
        phase: "approach",
        altitudeFt: 3000,
        speedKts: 190,
        headingDeg: 224,
        positionNm: at(10.8),
        assignedRunway: "22L",
        etaMin: 7,
        squawk: "2762",
      }),
    ],
  };
};

// ASRS CALLBACK Issue 461, June 2018 ("Clear Weather, Clear Choice, and Clear
// of Traffic"). A departure off IAH 15L level at its assigned 2,000 ft, ATC
// advising traffic crossing overhead at 3,000 ft, all three pilots with the
// traffic in sight; TCAS issued a climb RA anyway, the crew disregarded it
// with the traffic in sight, and the crossing completed uneventfully. The
// 1,000 ft crossing separation is normal operation, and it sits exactly on
// the proximity doctrine's vertical boundary (the predicate requires a gap
// strictly inside 1,000 ft), so the encoded state must stay silent. The
// Embraer's model and the crossing type are not stated in the record, so
// both encode as UNKN rather than as an invented designator.
const buildNegativeAsrsIah = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KIAH DEP (ASRS CALLBACK 461 reconstruction)",
    flights: [
      baseFlight("asrs-iah-dep", "EJA210", {
        aircraft: "UNKN",
        wake: "medium",
        type: "departure",
        phase: "departed",
        altitudeFt: 2000,
        speedKts: 250,
        headingDeg: 150,
        positionNm: { x: 4, y: 6 },
        etaMin: 0,
        fuelMin: 180,
        squawk: "2763",
      }),
      baseFlight("asrs-iah-xing", "XING01", {
        aircraft: "UNKN",
        wake: "medium",
        type: "arrival",
        phase: "enroute",
        altitudeFt: 3000,
        speedKts: 210,
        headingDeg: 60,
        positionNm: { x: 4.1, y: 5.9 },
        etaMin: 18,
        fuelMin: 120,
        squawk: "2764",
      }),
    ],
  };
};

// NASA ASRS ACN 2069720, December 2023. An EMB-175 descending on an arrival
// into MIA airspace, sequenced behind a heavy 787, ATC caution issued; the
// wake encounter at 16,000 ft caused a 600 ft excursion, the crew asked for a
// vector and the flight resumed as normal. Doctrinally, en-route wake is
// advisory territory: the approach wake minima of TBL 5-5-2 do not apply to a
// descending en-route pair, so the wake doctrine must form no pair here, and
// the correct system output is nothing above a warning. The in-trail distance
// is not stated in the record; the encoding places the pair 6 NM apart, wide
// of every proximity envelope, so the assertion does not hinge on the unstated
// figure.
const buildNegativeAsrsZma = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "ZMA (ASRS ACN 2069720 reconstruction)",
    flights: [
      baseFlight("asrs-zma-lead", "HVY788", {
        aircraft: "B788",
        wake: "heavy",
        type: "arrival",
        phase: "enroute",
        altitudeFt: 15000,
        speedKts: 290,
        headingDeg: 330,
        positionNm: { x: 14, y: 20 },
        etaMin: 22,
        fuelMin: 150,
        squawk: "2765",
      }),
      baseFlight("asrs-zma-trail", "RPA175", {
        aircraft: "E75L",
        wake: "medium",
        type: "arrival",
        phase: "enroute",
        altitudeFt: 16000,
        speedKts: 270,
        headingDeg: 330,
        positionNm: { x: 17, y: 25.2 },
        etaMin: 25,
        fuelMin: 130,
        squawk: "2766",
      }),
    ],
  };
};

export const SCENARIOS: Scenario[] = [
  {
    id: "nominal",
    name: "Nominal Ops",
    brief: "Mixed traffic, mild fuel pressure. Baseline.",
    build: buildNominal,
  },
  {
    id: "wake-violation",
    name: "Wake-Turbulence Violation",
    brief: "Light jet sequenced too close behind heavy on 28L.",
    build: buildWakeViolation,
  },
  {
