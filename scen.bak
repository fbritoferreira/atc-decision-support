        positionNm: { x: -3, y: 4 },
        assignedRunway: "36R/18L",
        etaMin: 5,
        fuelMin: 80,
      }),
    ],
  };
};

// Comair 5191, Blue Grass Airport (KLEX), 27 August 2006, 06:06 local, dark.
// Cleared for runway 22 (7,003 ft, lit); began the takeoff roll on runway 26
// (3,501 ft, unlit). Ran off the end at ~137 kts. 49 of 50 aboard died.
// NTSB AAR-07/05 cited the crew's failure to use available cues to confirm
// position, with the single controller's non-observation of the roll among
// the factors. The runway-identity detector exists for this shape: the 37°
// gap between clearance heading and actual heading was present and checkable
// from the moment thrust was applied.
const buildComair5191 = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KLEX TWR",
    clockMin: 6 * 60 + 6,
    runways: [
      { id: "22", headingDeg: 227, lengthFt: 7003, mode: "departures", surfaceFriction: "dry" },
      { id: "26", headingDeg: 264, lengthFt: 3501, mode: "closed", surfaceFriction: "dry" },
    ],
    weather: {
      windDirDeg: 200,
      windKts: 5,
      gustsKts: 5,
      visibilityNm: 8,
      ceilingFt: 12000,
      condition: "VFR", // pre-dawn darkness, not IMC: the cues were lights, not clouds
      precipitation: "none",
    },
    flights: [
      baseFlight("com-5191", "COM5191", {
        aircraft: "CRJ1",
        wake: "medium",
        type: "departure",
        origin: "KLEX",
        destination: "KATL",
        phase: "queued",
        altitudeFt: 0,
        speedKts: 85, // accelerating through the roll; rejection still survivable
        headingDeg: 264, // aligned with 26, cleared for 22
        positionNm: { x: 0.3, y: 0.2 },
        assignedRunway: "22",
        fuelMin: 210,
        etaMin: 0,
        squawk: "2436",
      }),
    ],
  };
};

// American 11, 11 September 2001, reconstructed at ~08:30 EDT from the 9/11
// Commission Report and the NTSB flight path study: transponder switched off
// at 08:21, aircraft off-route and descending south toward Manhattan; United
// 175 still on its normal westbound profile, squawking its assigned code.
//
// This is the corpus's known-blind-spot case, and it is INTENDED to produce
// zero alerts. None of the four hijacked flights ever squawked 7500; the
// transponders were turned off. The detectable signatures that morning were
// transponder loss and route deviation, and this population can see neither:
// there is no squawk history, no flight-plan conformance, and in live mode an
// aircraft without a transponder does not exist at all, because ADS-B IS the
// transponder. On 2001 signatures this system is as blind as the 2001 system
// was. The scenario exists so that blindness is documented and testable
// rather than discovered by a reviewer.
const buildAA11 = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "ZNY (reconstruction)",
    clockMin: 8 * 60 + 30,
    flights: [
      baseFlight("aa-11", "AAL11", {
        aircraft: "B762",
        wake: "heavy",
        type: "arrival", // enroute over the sector; no runway assignment
        origin: "KBOS",
        destination: "KLAX",
        phase: "enroute",
        altitudeFt: 26500, // descending, per the flight path study
        speedKts: 430,
        headingDeg: 190, // ~100° off the filed westbound route
        positionNm: { x: 8, y: -30 },
        assignedRunway: undefined,
        fuelMin: 280,
        etaMin: 60,
        squawk: "----", // transponder off since 08:21
      }),
      baseFlight("ua-175", "UAL175", {
        aircraft: "B762",
        wake: "heavy",
        type: "arrival",
        origin: "KBOS",
        destination: "KLAX",
        phase: "enroute",
        altitudeFt: 31000, // still normal at 08:30; hijack began ~08:42
        speedKts: 470,
        headingDeg: 250,
        positionNm: { x: -25, y: -18 },
        assignedRunway: undefined,
        fuelMin: 300,
        etaMin: 70,
        squawk: "1470",
      }),
    ],
  };
};

// Synthetic drill for the squawk-emergency doctrine: a crew sets 7500 the way
