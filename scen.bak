const buildGateGridlock = (): SimState => {
  const base = seedState();
  const gates: Gate[] = base.gates.map((g) => ({ ...g, occupiedBy: undefined }));
  const b2 = gates.find((g) => g.id === "B2");
  if (b2) b2.occupiedBy = "stuck-tow";
  return {
    ...base,
    gates,
    flights: [
      baseFlight("g1", "UAL228", {
        aircraft: "B789",
        wake: "heavy",
        phase: "final",
        altitudeFt: 1200,
        speedKts: 155,
        positionNm: { x: -5, y: 0 },
        assignedRunway: "28L",
        assignedGate: "B2",
        etaMin: 3,
        fuelMin: 55,
      }),
      baseFlight("g2", "AAL77", {
        aircraft: "B77W",
        wake: "heavy",
        phase: "approach",
        altitudeFt: 3500,
        speedKts: 210,
        positionNm: { x: -16, y: -2 },
        assignedRunway: "28R",
        assignedGate: "B2",
        etaMin: 9,
        fuelMin: 70,
      }),
      baseFlight("g3", "FDX901", {
        aircraft: "B763",
        wake: "heavy",
        phase: "approach",
        altitudeFt: 5000,
        speedKts: 240,
        positionNm: { x: -25, y: 5 },
        assignedRunway: "28L",
        assignedGate: "B3",
        etaMin: 14,
        fuelMin: 85,
      }),
    ],
  };
};

const buildCrosswindStorm = (): SimState => {
  const base = seedState();
  return {
    ...base,
    // Rain without wet pavement was an inconsistency in the original seed;
    // the runway-surface doctrine made it observable.
    runways: base.runways.map((r) => ({ ...r, surfaceFriction: "wet" as const })),
    weather: {
      windDirDeg: 350,
      windKts: 32,
      gustsKts: 44,
      visibilityNm: 4,
      ceilingFt: 1800,
      condition: "MVFR",
      precipitation: "rain",
    },
    flights: [
      baseFlight("c1", "DAL101", {
        phase: "approach",
        positionNm: { x: -18, y: 3 },
        assignedRunway: "28L",
        etaMin: 9,
        fuelMin: 70,
      }),
      baseFlight("c2", "UAL202", {
        phase: "approach",
        positionNm: { x: -22, y: -1 },
        assignedRunway: "28R",
        etaMin: 11,
        fuelMin: 65,
      }),
      baseFlight("c3", "AAL303", {
        phase: "enroute",
        altitudeFt: 14000,
        speedKts: 380,
        positionNm: { x: -40, y: 10 },
        assignedRunway: "28L",
        etaMin: 19,
        fuelMin: 50,
      }),
    ],
  };
};

const buildCascadingRush = (): SimState => {
  const base = seedState();
  const flights: Flight[] = [];
  for (let i = 0; i < 6; i++) {
    flights.push(
      baseFlight(`s${i}`, `RUSH${100 + i}`, {
        aircraft: i % 2 === 0 ? "B738" : "A320",
        phase: "approach",
        altitudeFt: 6000 - i * 400,
        speedKts: 220,
        positionNm: { x: -15 - i * 3, y: i % 2 === 0 ? 1 : -1 },
        assignedRunway: "28L",
        etaMin: 4 + i * 1.5,
        fuelMin: 60 - i * 4,
      }),
    );
  }
  return { ...base, flights };
};

