};

// The five builders below extend the negative-control corpus from one scenario
// to six. Each encodes a shape that recurs in ASRS controller narratives: an
// event that looked like a conflict for a moment and resolved by ordinary
// procedure. The corpus-wide property, asserted in sim.test.ts, is that none of
// them produces a critical alert. Warning and advisory tiers are acceptable;
// several are expected to be completely silent, which is itself the assertion:
// a detector population that cannot stay quiet on legal operations has no
// business alerting on illegal ones.

// A trailing arrival breaks off and climbs on an offset heading while the
// leader continues. During the go-around the pair is briefly inside the
// warning envelope (1.6 NM / 800 ft) and never near the critical one.
const buildNegativeGoAround = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KJFK TWR (negative-control scenario)",
    flights: [
      baseFlight("ng-1", "JBU1607", {
        aircraft: "A321",
        phase: "final",
        altitudeFt: 1800,
        speedKts: 145,
        headingDeg: 281,
        positionNm: { x: -8, y: 1 },
        assignedRunway: "28L",
        etaMin: 4,
        squawk: "3411",
      }),
      baseFlight("ng-2", "DAL2158", {
        aircraft: "B739",
        phase: "approach",
        altitudeFt: 2600,
        speedKts: 180,
        headingDeg: 311, // 30° offset: the go-around diverges from the leader
        positionNm: { x: -9.2, y: 2 },
        assignedRunway: undefined, // broke off the approach
        etaMin: 12,
        squawk: "3412",
      }),
    ],
  };
};

// Two departures on crossing runways released in sequence: one already
// airborne and climbing away, one holding short. No simultaneous occupancy, no
// proximity. Expected output: silence.
const buildNegativeConvergingDeps = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KORD TWR (negative-control scenario)",
    flights: [
      baseFlight("ncd-1", "UAL1015", {
        aircraft: "B772",
        wake: "heavy",
        type: "departure",
        origin: "KSFO",
        destination: "EGLL",
        phase: "departed",
        altitudeFt: 3200,
        speedKts: 250,
        headingDeg: 14,
        positionNm: { x: 4, y: -9 },
        fuelMin: 480,
        etaMin: 0,
        squawk: "3421",
      }),
      baseFlight("ncd-2", "SWA711", {
        aircraft: "B738",
        type: "departure",
        origin: "KSFO",
        destination: "KPHX",
        phase: "queued",
        altitudeFt: 0,
        speedKts: 0,
        headingDeg: 104,
        positionNm: { x: 1.2, y: 0.4 },
        assignedRunway: "01L",
        fuelMin: 240,
        etaMin: 0,
        squawk: "3422",
      }),
    ],
  };
};

// Three arrivals to the same runway at legal wake spacing: heavy, then medium
// at a 4-minute gap against a 3-minute requirement, then medium at 5. Legal
// flow at capacity is the ordinary state of a busy field, and the system must
// treat it as unremarkable. Expected output: silence.
// Legal in-trail spacing on ONE approach stream. This control has to make the
// wake detector actually run, which the previous version did not: its arrivals
// sat at y = 0.5, 1.5 and 0.0, which is 1.5 NM of lateral spread against the
// 0.1 NM stream threshold, so they split into three streams and formed zero
// pairs. It passed by never reaching the doctrine it claimed to test.
//
// Two constraints have to hold together for a pair to form at all, and both
// are easy to violate by accident:
//   1. cross-track within LATERAL_CLUSTER_NM, hence y = 0.1933x for heading
//      281, the same centreline convention buildWakeViolation uses;
//   2. the follower no more than WAKE_VERTICAL_BAND_FT above the leader.
//
// Constraint 2 is why the altitudes step by 800 ft rather than following a 3
// degree glideslope: on a glideslope, 9 NM of in-trail separation puts the
// follower about 2,900 ft higher, outside the vortex band, and the pair is
// skipped. Aircraft level on an intermediate segment before glideslope
// intercept is the ordinary case this represents.
const buildNegativeStaggered = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KDEN TWR (negative-control scenario)",
    flights: [
      baseFlight("ns-1", "UAL339", {
        aircraft: "B77W",
        wake: "heavy",
        phase: "final",
        altitudeFt: 2000,
        speedKts: 155,
        positionNm: { x: -6, y: -1.16 },
        assignedRunway: "28L",
        etaMin: 4,
        squawk: "3431",
      }),
      // 9.17 NM behind a heavy, which requires 5 NM. Legal.
      baseFlight("ns-2", "FFT802", {
        aircraft: "A320",
        phase: "approach",
        altitudeFt: 2800,
        speedKts: 205,
        positionNm: { x: -15, y: -2.9 },
        assignedRunway: "28L",
        etaMin: 8,
        squawk: "3432",
      }),
      // 10.19 NM behind a medium, which requires 3 NM. Legal.
      baseFlight("ns-3", "SKW4519", {
        aircraft: "E75L",
        phase: "approach",
        altitudeFt: 3600,
        speedKts: 230,
        positionNm: { x: -25, y: -4.83 },
        assignedRunway: "28L",
        etaMin: 13,
        squawk: "3433",
      }),
    ],
  };
};

// Simultaneous independent ILS approaches to parallel runways, at the FAA's
// minimum runway separation for that procedure: 4,300 ft, which is 0.708 NM.
// This is ordinary high-density operations, not a conflict. Both aircraft are
// established, tracking the localiser, abreast at the same altitude, and
// legally separated by the lateral distance the procedure is built on.
//
// It is a control for the proximity doctrine, and unlike the others it is
// expected to FAIL at warning tier, which is why it exists. The warning tier is
// `horizNm < 2 && vertFt < 1000` over every pair of active aircraft, so a legal
// parallel pair 0.708 NM abreast sits inside it permanently. The critical tier
// must stay silent, because the convergence test added for exactly this reason
// sees no closure between two parallel tracks.
//
// External corroboration that this geometry is a known false-alarm source
// rather than the author's opinion: NASA ASRS CALLBACK reports parallel-approach
// TCAS nuisance alerts on blunder-free approaches within roughly 2,500 ft, and
// the AILS work suppresses advisories for specific aircraft on parallel
// approaches for the same reason. TCAS's own nuisance radius is about 0.41 NM;
// this detector's warning box is 2 NM, roughly five times wider.
const buildNegativeParallelApproach = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    // KSFO, not KORD. This control flies 28L and 28R at 4,300 ft with 01L and
    // 01R also declared, which is San Francisco's layout and not O'Hare's, and
    // Section 6.8 describes it as arrivals abreast on KSFO's 28L and 28R. The
    // paper and the geometry agreed; the label did not.
    sectorId: "KSFO TWR (negative-control scenario)",
    flights: [
      baseFlight("np-1", "UAL418", {
        aircraft: "B739",
        phase: "final",
        altitudeFt: 2500,
        speedKts: 160,
        positionNm: { x: -8, y: -1.546 },
        assignedRunway: "28L",
        etaMin: 4,
        squawk: "3451",
      }),
      baseFlight("np-2", "AAL1902", {
        aircraft: "A321",
        phase: "final",
        altitudeFt: 2500,
        speedKts: 158,
        positionNm: { x: -7.865, y: -2.241 },
        assignedRunway: "28R",
        etaMin: 4,
        squawk: "3452",
      }),
    ],
  };
};

// The boundary case the corpus was missing: spacing that is legal but close,
// rather than legal and comfortable. A medium 5.3 NM behind a heavy is inside
// the 5 NM requirement by 0.3 NM, so the detector must stay silent while
// having genuinely evaluated the pair. A control that is silent because no
// pair formed proves nothing about the threshold; this one is silent because
// the threshold is correct.
const buildNegativeWakeAtMinimum = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KDEN TWR (negative-control scenario)",
    flights: [
      baseFlight("nm-1", "DAL1902", {
        aircraft: "B77W",
        wake: "heavy",
        phase: "final",
        altitudeFt: 1600,
        speedKts: 150,
        positionNm: { x: -3, y: -0.58 },
        assignedRunway: "28L",
        etaMin: 3,
        squawk: "3441",
      }),
      baseFlight("nm-2", "AAL2288", {
        aircraft: "A321",
        phase: "final",
        altitudeFt: 2400,
        speedKts: 165,
        positionNm: { x: -8.2, y: -1.59 },
        assignedRunway: "28L",
        etaMin: 6,
        squawk: "3442",
      }),
    ],
  };
};

// Two transiting aircraft laterally close (1.9 NM) but vertically separated by
// 1,500 ft, the everyday geometry of a VFR corridor. The proximity predicate
// requires BOTH axes inside its envelope, so the vertical separation must keep
// this silent. This is the control that failed in the withdrawn Table 1, where
// the reimplemented detector counted 218 such pairs as conflicts.
const buildNegativeVfrCorridor = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KLAX TWR (negative-control scenario)",
    flights: [
      baseFlight("nv-1", "N481TC", {
        aircraft: "C172",
        wake: "light",
        phase: "enroute",
        altitudeFt: 3500,
        speedKts: 110,
        headingDeg: 90,
        positionNm: { x: -2, y: -6 },
        assignedRunway: undefined,
        etaMin: 25,
        squawk: "1200",
      }),
      baseFlight("nv-2", "N9202M", {
        aircraft: "PA28",
        wake: "light",
        phase: "enroute",
        altitudeFt: 5000,
        speedKts: 120,
        headingDeg: 270,
        positionNm: { x: -2.5, y: -4.2 },
        assignedRunway: undefined,
        etaMin: 28,
        squawk: "1200",
      }),
    ],
  };
};

// Sustained crosswind component of ~22 kts against the 25 kt limit: inside
// margins, and exactly the condition a threshold tuned by round number rather
// than by doctrine would false-alarm on. Expected output: silence.
const buildNegativeCrosswindOps = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "KBOS TWR (negative-control scenario)",
    weather: {
      windDirDeg: 104, // 90° off the 01L/01R heading of 014°
      windKts: 18,
      gustsKts: 22,
      visibilityNm: 9,
      ceilingFt: 6000,
      condition: "VFR",
      precipitation: "none",
    },
    flights: [
      baseFlight("nx-1", "ACA759", {
        aircraft: "A320",
        phase: "approach",
        altitudeFt: 3900,
        speedKts: 200,
        headingDeg: 14,
