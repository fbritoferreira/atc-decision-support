const buildTenerife1977 = (): SimState => {
  const base = seedState();
  return {
    ...base,
    speed: 0,
    sectorId: "GCXO TWR (reconstruction)",
    // Los Rodeos (GCXO; GCRR is Lanzarote): single runway 12/30, 3,400 m. Both 747s were on
    // runway 30; heading stored for the direction in use.
    runways: [
      { id: "12/30", headingDeg: 296, lengthFt: 11155, mode: "mixed", surfaceFriction: "dry" },
    ],
    weather: lowVisFog,
    flights: [
      baseFlight("klm-4805", "KLM4805", {
        aircraft: "B742",
        wake: "heavy",
        type: "departure",
        origin: "GCXO",
        destination: "EHAM",
        phase: "queued",
        altitudeFt: 0,
        speedKts: 30,
        headingDeg: 300,
        positionNm: { x: 0, y: -0.3 },
        assignedRunway: "12/30",
        etaMin: 0,
        fuelMin: 380,
        squawk: "1107",
      }),
      baseFlight("paa-1736", "PAA1736", {
        aircraft: "B742",
        wake: "heavy",
        type: "departure",
        origin: "GCXO",
        destination: "KLAX",
        phase: "queued",
        altitudeFt: 0,
        speedKts: 10,
        headingDeg: 120,
        positionNm: { x: -0.4, y: 0.2 },
        assignedRunway: "12/30",
        etaMin: 0,
        fuelMin: 420,
        // Mode 3/A codes are octal, so no digit above 7 exists. This read
        // "1108" until 2026-08-29, which is not a code any transponder can
        // set. The value is illustrative filler either way, and the last
        // digit is changed rather than the whole code so it stays the
        // number the scenario author reached for.
        squawk: "1107",
      }),
    ],
  };
};

